{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-scientist-skills.local/schemas/medical-imaging-model-extension-1.0.0.json",
  "title": "Medical-imaging model evaluation contract extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intended_use",
    "modality",
    "task",
    "clinical_unit",
    "split_unit",
    "reference_standard",
    "external_validation_axis"
  ],
  "properties": {
    "intended_use": {"type": "string", "minLength": 1},
    "modality": {"type": "string", "minLength": 1},
    "task": {"enum": ["classification", "detection", "segmentation", "registration", "reconstruction", "quantification", "other"]},
    "clinical_unit": {"type": "string", "minLength": 1},
    "split_unit": {"type": "string", "minLength": 1},
    "reference_standard": {"type": "string", "minLength": 1},
    "external_validation_axis": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "reader_study": {"type": "boolean"},
    "abstention_allowed": {"type": "boolean"}
  }
}
