{
  "schema_version": "1.0.0",
  "artifact_type": "domain_check_profile",
  "profile_id": "single-cell-analysis",
  "scope": "single-cell",
  "contract_extension": {
    "key": "single_cell_analysis",
    "schema": "../single-cell-contract-extension.schema.json"
  },
  "verification": {
    "required_categories": [
      "single-cell-qc",
      "single-cell-inference"
    ],
    "catalog": "../single-cell-check-catalog.md"
  },
  "categories": [
    {
      "category_id": "single-cell-qc",
      "description": "Cell-level preprocessing and sample retention."
    },
    {
      "category_id": "single-cell-inference",
      "description": "Replicate-aware inference and derived-state interpretation."
    }
  ],
  "checks": [
    {
      "check_id": "single-cell:qc-retention",
      "category": "single-cell-qc",
      "criterion": "Per-sample cell counts and QC thresholds are visible before and after filtering.",
      "severity": "error"
    },
    {
      "check_id": "single-cell:doublet-ambient",
      "category": "single-cell-qc",
      "criterion": "Doublets and ambient RNA are evaluated or explicitly justified without silent cell loss.",
      "severity": "warning"
    },
    {
      "check_id": "single-cell:integration-balance",
      "category": "single-cell-qc",
      "criterion": "Integration is assessed for both batch mixing and biological conservation.",
      "severity": "warning"
    },
    {
      "check_id": "single-cell:annotation-evidence",
      "category": "single-cell-inference",
      "criterion": "Cell-type labels have discriminatory marker evidence independent of circular reference transfer.",
      "severity": "error"
    },
    {
      "check_id": "single-cell:replicate-aware-inference",
      "category": "single-cell-inference",
      "criterion": "Condition-level expression and composition tests use biological replicates as the inferential units.",
      "severity": "error"
    },
    {
      "check_id": "single-cell:identifiability",
      "category": "single-cell-inference",
      "criterion": "Trajectory, communication, regulatory-network, and spatial claims respect method identifiability and are not presented as causal by default.",
      "severity": "warning"
    }
  ],
  "extensions": {}
}
