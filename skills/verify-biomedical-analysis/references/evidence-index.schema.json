{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-scientist-skills.local/schemas/evidence-index-1.1.0.json",
  "title": "Biomedical evidence index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "contract_id", "run_id", "claims", "evidence_items", "extensions"],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "artifact_type": {"const": "evidence_index"},
    "contract_id": {"$ref": "#/$defs/id"},
    "run_id": {"$ref": "#/$defs/id"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "question_id", "statement", "verdict", "evidence_ids", "limitations"],
        "properties": {
          "claim_id": {"$ref": "#/$defs/id"},
          "question_id": {"$ref": "#/$defs/id"},
          "statement": {"$ref": "#/$defs/text"},
          "verdict": {"enum": ["supported", "not_supported", "inconclusive", "technical_failure"]},
          "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
          "limitations": {"type": "array", "items": {"$ref": "#/$defs/text"}}
        }
      }
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "kind", "summary", "source", "statistics"],
        "properties": {
          "evidence_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["statistic", "table", "figure", "model", "qc", "literature", "other"]},
          "summary": {"$ref": "#/$defs/text"},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "id", "locator"],
            "properties": {
              "type": {"enum": ["artifact", "external_source", "resource"]},
              "id": {"$ref": "#/$defs/id"},
              "locator": {"$ref": "#/$defs/text"}
            }
          },
          "execution_id": {"$ref": "#/$defs/id"},
          "data_context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "contrast_id": {"$ref": "#/$defs/id"},
              "outcome_id": {"$ref": "#/$defs/id"},
              "analysis_set_id": {"$ref": "#/$defs/id"},
              "unit_type": {"$ref": "#/$defs/text"},
              "unit_set_artifact_id": {"$ref": "#/$defs/id"},
              "sample_set_id": {"$ref": "#/$defs/id"},
              "sample_ids_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "statistics": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "value"],
              "properties": {
                "name": {"$ref": "#/$defs/id"},
                "value": {"type": ["number", "integer", "string"]},
                "unit": {"$ref": "#/$defs/text"},
                "n": {"type": "integer", "minimum": 0},
                "count_basis": {"$ref": "#/$defs/text"},
                "denominator": {"type": "number", "minimum": 0},
                "interval": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["level", "lower", "upper"],
                  "properties": {
                    "level": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
                    "lower": {"type": "number"},
                    "upper": {"type": "number"}
                  }
                },
                "p_value": {"type": "number", "minimum": 0, "maximum": 1},
                "adjusted_p_value": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
