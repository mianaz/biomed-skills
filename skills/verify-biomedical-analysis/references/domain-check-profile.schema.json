{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-scientist-skills.local/schemas/domain-check-profile-1.0.0.json",
  "title": "Biomedical domain verification profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "scope",
    "contract_extension",
    "verification"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "domain_check_profile"},
    "profile_id": {"$ref": "#/$defs/id"},
    "scope": {"$ref": "#/$defs/id"},
    "contract_extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "schema"],
      "properties": {
        "key": {"$ref": "#/$defs/id"},
        "schema": {"$ref": "#/$defs/text"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_categories", "catalog"],
      "properties": {
        "required_categories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "catalog": {"$ref": "#/$defs/text"}
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category_id", "description"],
        "properties": {
          "category_id": {"$ref": "#/$defs/id"},
          "description": {"$ref": "#/$defs/text"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "category", "criterion", "severity"],
        "properties": {
          "check_id": {"$ref": "#/$defs/id"},
          "category": {"$ref": "#/$defs/id"},
          "criterion": {"$ref": "#/$defs/text"},
          "severity": {"enum": ["error", "warning"]}
        }
      }
    },
    "extensions": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "text": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
  }
}
