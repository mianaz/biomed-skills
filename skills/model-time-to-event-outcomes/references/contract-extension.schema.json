{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-scientist-skills.local/schemas/clinical-time-to-event-extension-1.0.0.json",
  "title": "Clinical time-to-event contract extension",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target_population",
    "time_origin",
    "time_scale",
    "event_definition",
    "competing_events",
    "censoring_definition",
    "delayed_entry",
    "estimand",
    "follow_up_end"
  ],
  "properties": {
    "target_population": {"type": "string", "minLength": 1},
    "time_origin": {"type": "string", "minLength": 1},
    "time_scale": {"type": "string", "minLength": 1},
    "event_definition": {"type": "string", "minLength": 1},
    "competing_events": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "censoring_definition": {"type": "string", "minLength": 1},
    "delayed_entry": {"enum": ["present", "absent", "unknown"]},
    "estimand": {"type": "string", "minLength": 1},
    "follow_up_end": {"type": "string", "minLength": 1},
    "recurrent_events": {"enum": ["present", "absent", "unknown"]},
    "causal_target": {"type": "boolean"}
  }
}
