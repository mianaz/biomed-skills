{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-scientist-skills.local/schemas/analysis-contract-1.1.0.json",
  "title": "Biomedical analysis contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "contract_id",
    "profile",
    "objective",
    "questions",
    "inputs",
    "design",
    "steps",
    "required_outputs",
    "validation",
    "constraints",
    "audiences",
    "extensions"
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "1.1.0"]},
    "artifact_type": {"const": "analysis_contract"},
    "contract_id": {"$ref": "#/$defs/id"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_mode", "assurance", "autonomy"],
      "properties": {
        "analysis_mode": {"enum": ["exploratory", "confirmatory"]},
        "assurance": {"enum": ["basic", "standard", "strict"]},
        "autonomy": {"enum": ["autonomous", "collaborative", "approval_required"]}
      }
    },
    "objective": {"$ref": "#/$defs/text"},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question_id", "text"],
        "properties": {
          "question_id": {"$ref": "#/$defs/id"},
          "text": {"$ref": "#/$defs/text"}
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input_id", "role", "required", "description"],
        "properties": {
          "input_id": {"$ref": "#/$defs/id"},
          "role": {"$ref": "#/$defs/id"},
          "required": {"type": "boolean"},
          "description": {"$ref": "#/$defs/text"}
        }
      }
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_type", "analysis_unit", "factors", "contrasts", "covariates"],
      "properties": {
        "study_type": {"$ref": "#/$defs/text"},
        "analysis_unit": {"$ref": "#/$defs/text"},
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["unit_id", "description"],
            "properties": {
              "unit_id": {"$ref": "#/$defs/id"},
              "description": {"$ref": "#/$defs/text"},
              "parent_unit_id": {"$ref": "#/$defs/id"}
            }
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["outcome_id", "role", "definition"],
            "properties": {
              "outcome_id": {"$ref": "#/$defs/id"},
              "role": {"enum": ["primary", "secondary", "exploratory", "safety", "other"]},
              "definition": {"$ref": "#/$defs/text"},
              "unit_id": {"$ref": "#/$defs/id"}
            }
          }
        },
        "analysis_sets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["analysis_set_id", "unit_id", "definition"],
            "properties": {
              "analysis_set_id": {"$ref": "#/$defs/id"},
              "unit_id": {"$ref": "#/$defs/id"},
              "definition": {"$ref": "#/$defs/text"}
            }
          }
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["factor_id", "levels"],
            "properties": {
              "factor_id": {"$ref": "#/$defs/id"},
              "levels": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "#/$defs/text"}
              }
            }
          }
        },
        "contrasts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contrast_id", "definition"],
            "properties": {
              "contrast_id": {"$ref": "#/$defs/id"},
              "definition": {"$ref": "#/$defs/text"}
            }
          }
        },
        "covariates": {
          "type": "array",
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_subjects", "animals", "sensitive_data", "hazardous_materials", "approvals", "restrictions"],
      "properties": {
        "human_subjects": {"$ref": "#/$defs/risk_answer"},
        "animals": {"$ref": "#/$defs/risk_answer"},
        "sensitive_data": {"$ref": "#/$defs/risk_answer"},
        "hazardous_materials": {"$ref": "#/$defs/risk_answer"},
        "approvals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        },
        "restrictions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/text"}
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "purpose"],
        "properties": {
          "step_id": {"$ref": "#/$defs/id"},
          "purpose": {"$ref": "#/$defs/text"},
          "method": {"$ref": "#/$defs/text"},
          "selection_rule": {"$ref": "#/$defs/text"}
        },
        "anyOf": [
          {"required": ["method"]},
          {"required": ["selection_rule"]}
        ]
      }
    },
    "required_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_id", "kind", "description"],
        "properties": {
          "output_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["table", "figure", "model", "data", "report", "other"]},
          "description": {"$ref": "#/$defs/text"}
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "criterion", "severity"],
        "properties": {
          "check_id": {"$ref": "#/$defs/id"},
          "criterion": {"$ref": "#/$defs/text"},
          "severity": {"enum": ["error", "warning"]}
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["constraint_id", "kind", "text"],
        "properties": {
          "constraint_id": {"$ref": "#/$defs/id"},
          "kind": {"enum": ["data", "compute", "time", "policy", "user", "other"]},
          "text": {"$ref": "#/$defs/text"}
        }
      }
    },
    "audiences": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "strict_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_lockfile",
        "require_container",
        "require_fixed_references",
        "require_cached_sources",
        "require_rerun",
        "numeric_tolerance"
      ],
      "properties": {
        "require_lockfile": {"type": "boolean"},
        "require_container": {"type": "boolean"},
        "require_fixed_references": {"type": "boolean"},
        "require_cached_sources": {"type": "boolean"},
        "require_rerun": {"type": "boolean"},
        "numeric_tolerance": {"type": "number", "minimum": 0}
      }
    },
    "extensions": {
      "type": "object",
      "properties": {
        "profiles": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/id"},
          "additionalProperties": {"type": "object"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "properties": {"assurance": {"const": "strict"}},
            "required": ["assurance"]
          }
        }
      },
      "then": {"required": ["strict_policy"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.1.0"}}, "required": ["schema_version"]},
      "then": {
        "required": ["governance"],
        "properties": {
          "design": {"required": ["units", "outcomes", "analysis_sets"]},
          "extensions": {"required": ["profiles"]}
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "risk_answer": {"enum": ["yes", "no", "unknown", "not_applicable"]}
  }
}
