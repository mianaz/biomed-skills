{
  "schema_version": "1.0.0",
  "artifact_type": "analysis_contract",
  "contract_id": "ctr-minimal",
  "profile": {
    "analysis_mode": "confirmatory",
    "assurance": "standard",
    "autonomy": "autonomous"
  },
  "objective": "Test whether the prespecified feature differs between treated and control samples.",
